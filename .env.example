# Это шаблон. Скопируйте его в `.env` и заполните реальными значениями.
# Файл `.env` в git НЕ попадает — там пароли.
# На новом устройстве: cp .env.example .env, потом вписать значения.

# ─── PostgreSQL (Docker) ───
POSTGRES_USER=inntek
POSTGRES_PASSWORD=change_me_to_strong_password
POSTGRES_DB=inntek

# ─── Backend ───
# Сгенерировать случайную строку 32+ символов: openssl rand -hex 32
JWT_SECRET=change_me_to_random_32_chars

# ─── Printer (LabelJetty на ноуте с принтером) ───
# Оставьте пустым для dev-режима — TSPL пишется в backend/printed/
# Для реальной печати: http://<ip-ноута>:8888
PRINTER_URL=

# Таймаут HTTP-запроса к LabelJetty, секунд
PRINTER_TIMEOUT=15.0